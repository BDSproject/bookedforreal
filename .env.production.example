# ---------------------------------------------------------------------------
# Bookedforreal — PRODUCTION environment variables (copy to each service).
# Never commit real secrets. Generate them with `openssl rand -hex 32`.
# ---------------------------------------------------------------------------

# --- App URLs -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://bookedforreal.com"
NEXT_PUBLIC_API_URL="https://api.bookedforreal.com"

# --- PostgreSQL (O2switch) ------------------------------------------------
# Use pgBouncer (port 6432) if connection pooling is required.
DATABASE_URL="postgresql://bookedforreal:PASSWORD@localhost:5432/bookedforreal?schema=public"

# --- Auth (JWT) -----------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Brevo (transactional email) ------------------------------------------
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_EMAIL="noreply@bookedforreal.com"

# --- Twilio (SMS / WhatsApp) ----------------------------------------------
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+33..."

# --- Monitoring -----------------------------------------------------------
SENTRY_DSN="https://...@sentry.io/..."
NEXT_PUBLIC_UMAMI_WEBSITE_ID="..."
NEXT_PUBLIC_UMAMI_URL="https://analytics.bookedforreal.com/script.js"

# --- API (Fastify) --------------------------------------------------------
API_HOST="0.0.0.0"
API_PORT="4000"
# Comma-separated list of allowed origins (web + salon subdomains).
CORS_ORIGIN="https://bookedforreal.com,https://*.bookedforreal.com"
