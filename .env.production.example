# ---------------------------------------------------------------------------
# Bookedforreal — PRODUCTION environment variables (copy to each service).
# Never commit real secrets. Generate them with `openssl rand -hex 32`.
# ---------------------------------------------------------------------------

# --- App URLs -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://bookedforreal.com"
NEXT_PUBLIC_API_URL="https://api.bookedforreal.com"

# --- PostgreSQL (O2switch) ------------------------------------------------
# Use pgBouncer (port 6432) if connection pooling is required.
DATABASE_URL="postgresql://bookedforreal:PASSWORD@localhost:5432/bookedforreal?schema=public"

# --- Auth (JWT) -----------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Notifications: pick ONE provider -------------------------------------
# NOTIFY_PROVIDER = "twilio" or "telnyx". When it is unset, Telnyx is used as
# soon as TELNYX_API_KEY exists, otherwise Twilio. Both carry SMS *and*
# WhatsApp, so the WhatsApp → SMS fallback works the same either way.
#
# NOTIFY_MESSAGES = "minimal" (default) or "full".
# "minimal" sends one message per booking — the J-1 reminder, the one that cuts
# no-shows. "full" adds the immediate confirmation and the salon alert. Keep
# "minimal" unless you are comfortable paying three messages per booking.

# --- Twilio (SMS + WhatsApp) ----------------------------------------------
# Reminders go out on WhatsApp (cheaper), and fall back to SMS automatically
# when WhatsApp is unavailable, so both senders are required.
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+33..."
TWILIO_WHATSAPP_NUMBER="+33..."
# Approved Twilio Content templates (HX...). Without them the chain uses SMS.
# Placeholders: {{1}} salon, {{2}} date, {{3}} time, {{4}} service, {{5}} client.
TWILIO_CONTENT_CONFIRMATION="HX..."
TWILIO_CONTENT_REMINDER="HX..."
TWILIO_CONTENT_OWNER_ALERT="HX..."
TWILIO_CONTENT_TEST="HX..."

# --- Telnyx (alternative to Twilio) ---------------------------------------
# WhatsApp at Meta's rate with no markup, and cheaper SMS in France.
# Same fallback chain: WhatsApp first, then SMS.
# NOTIFY_PROVIDER="telnyx"
TELNYX_API_KEY="KEY..."
TELNYX_PHONE_NUMBER="+33..."
TELNYX_WHATSAPP_NUMBER="+33..."
# Approved Meta template names or UUIDs (created via Telnyx → WhatsApp).
# Same placeholder order as Twilio: {{1}} salon, {{2}} date, {{3}} time,
# {{4}} service, {{5}} client. The test template takes no variable.
TELNYX_TEMPLATE_LANGUAGE="fr"
TELNYX_TEMPLATE_CONFIRMATION="rdv_confirmation"
TELNYX_TEMPLATE_REMINDER="rdv_rappel"
TELNYX_TEMPLATE_OWNER_ALERT="rdv_nouveau"
TELNYX_TEMPLATE_TEST="rdv_test"

# --- Google Sign-In + verification email ----------------------------------
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_EMAIL="noreply@bookedforreal.com"

# --- Monitoring -----------------------------------------------------------
SENTRY_DSN="https://...@sentry.io/..."
NEXT_PUBLIC_UMAMI_WEBSITE_ID="..."
NEXT_PUBLIC_UMAMI_URL="https://analytics.bookedforreal.com/script.js"

# --- API (Fastify) --------------------------------------------------------
API_HOST="0.0.0.0"
API_PORT="4000"
# Comma-separated list of allowed origins (web + salon subdomains).
CORS_ORIGIN="https://bookedforreal.com,https://*.bookedforreal.com"
