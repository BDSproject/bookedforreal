# ---------------------------------------------------------------------------
# Bookedforreal — environment variables template.
#
# Copy this file to the package(s) that need it:
#   cp .env.example packages/db/.env        # Prisma CLI (migrate, seed, studio)
#   cp .env.example apps/api/.env           # Fastify runtime + Prisma client
#   cp .env.example apps/web/.env.local     # Next.js (public/prefix variables)
#
# Never commit real secrets. Local dev values below match docker-compose.yml.
# ---------------------------------------------------------------------------

# --- PostgreSQL -----------------------------------------------------------
# Read by: Prisma CLI (packages/db) and the Prisma client at runtime (apps/api).
DATABASE_URL="postgresql://bookedforreal:bookedforreal@localhost:5433/bookedforreal?schema=public"

# --- Web (Next.js) --------------------------------------------------------
# Public variables exposed to the browser; prefix them with NEXT_PUBLIC_*.
# Read by: apps/web (metadata base URL, sitemap, robots).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- API (Fastify) --------------------------------------------------------
# Read by: apps/api/src/server.ts and apps/api/src/app.ts.
API_HOST="0.0.0.0"
API_PORT="4000"
# Comma-separated list of allowed origins for CORS.
CORS_ORIGIN="http://localhost:3000"
