# ---------------------------------------------------------------------------
# Bookedforreal — shared environment variables (copy to .env in each package)
# ---------------------------------------------------------------------------

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://bookedforreal:bookedforreal@localhost:5432/bookedforreal?schema=public"

# Web (Next.js)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# API (Fastify)
API_HOST="0.0.0.0"
API_PORT="4000"
CORS_ORIGIN="http://localhost:3000"
