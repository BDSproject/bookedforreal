# ---------------------------------------------------------------------------
# Bookedforreal — environment variables template.
#
# Copy this file to the package(s) that need it:
#   cp .env.example packages/db/.env        # Prisma CLI (migrate, seed, studio)
#   cp .env.example apps/api/.env           # Fastify runtime + Prisma client
#   cp .env.example apps/web/.env.local     # Next.js (public/prefix variables)
#
# Never commit real secrets. Local dev values below match docker-compose.yml.
# ---------------------------------------------------------------------------

# --- PostgreSQL -----------------------------------------------------------
# Read by: Prisma CLI (packages/db) and the Prisma client at runtime (apps/api).
#
# Hosted (Neon — serverless Postgres): copy the *direct* connection string from
# the Neon dashboard → Connect, and keep `sslmode=require`.
#   DATABASE_URL="postgresql://<user>:<password>@ep-<id>.<region>.aws.neon.tech/<db>?sslmode=require"
# Local: matches docker-compose.yml (`pnpm db:up`).
DATABASE_URL="postgresql://bookedforreal:bookedforreal@localhost:5433/bookedforreal?schema=public"

# --- Web (Next.js) --------------------------------------------------------
# Public variables exposed to the browser; prefix them with NEXT_PUBLIC_*.
# Read by: apps/web (metadata base URL, sitemap, robots).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- API (Fastify) --------------------------------------------------------
# Read by: apps/api/src/server.ts and apps/api/src/app.ts.
API_HOST="0.0.0.0"
API_PORT="4000"
# Comma-separated list of allowed origins for CORS (web + Expo web preview).
CORS_ORIGIN="http://localhost:3000,http://localhost:8081"

# --- Auth (JWT) -----------------------------------------------------------
# Long random strings in production (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET="dev-access-secret"
JWT_REFRESH_SECRET="dev-refresh-secret"

# --- Stripe ---------------------------------------------------------------
# Read by: apps/api (billing). Test keys in dev; live keys in production.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_USAGE="price_usage"
STRIPE_PRICE_SOLO="price_solo"
STRIPE_PRICE_SALON="price_salon"
# Annual prices (billed once a year, ~-20%).
STRIPE_PRICE_SOLO_YEARLY="price_solo_yearly"
STRIPE_PRICE_SALON_YEARLY="price_salon_yearly"
# Group plan: quoted by sales, price id only needed to open a checkout session.
STRIPE_PRICE_GROUP="price_group"
# The USAGE price must be metered: add it to the subscription as a second item.
