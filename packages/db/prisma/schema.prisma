// Bookedforreal — PostgreSQL schema (multi-tenant by Salon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Account role. Note: `STAFF` here is a login role, distinct from the `Staff` model.
enum UserRole {
  OWNER
  STAFF
  ADMIN
}

enum Plan {
  /// Pay-as-you-go: 0 €/month + a flat fee per booking.
  USAGE
  /// Solo professional — one chair.
  SOLO
  /// Salon with a team.
  SALON
  /// Multi-shop group (sales-led, quoted).
  GROUP
}

/// Business category, used for SEO pages and Schema.org type.
enum SalonType {
  HAIR_SALON
  BARBER_SHOP
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DONE
  NO_SHOW
}

enum AppointmentSource {
  WEB
  MOBILE
  MANUAL
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Authentication account. Platform-wide (not tenant-scoped): an OWNER owns a
/// Salon; STAFF/ADMIN accounts can log in to manage.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  locale       String   @default("fr")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salon Salon?

  @@map("users")
}

/// A salon is the tenant boundary: staff, services, clients and appointments
/// belong to one salon.
model Salon {
  id               String    @id @default(cuid())
  ownerId          String    @unique
  /// Unique public tenant identifier — the unique constraint also provides the lookup index.
  slug             String    @unique
  name             String
  /// Business category (coiffeur vs barbier) for SEO landing pages.
  type             SalonType @default(HAIR_SALON)
  /// Neighborhood/district for local SEO landing pages.
  district         String?
  address          String?
  city             String?
  postalCode       String?
  country          String    @default("FR")
  phone            String?
  email            String?
  logoUrl          String?
  primaryColor     String    @default("#7C3AED")
  description      String?
  timezone         String    @default("Europe/Paris")
  plan             Plan      @default(SOLO)
  /// Stripe customer id (stable, one per salon).
  stripeCustomerId String?   @unique
  /// Denormalized id of the active Stripe subscription (see Subscription).
  stripeSubId      String?
  trialEndsAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner             User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  staff             Staff[]
  services          Service[]
  serviceCategories ServiceCategory[]
  timeBlocks        TimeBlock[]
  availabilities Availability[]
  clients        Client[]
  appointments   Appointment[]
  subscription   Subscription?
  reviews        Review[]
  pages          Page[]

  @@map("salons")
}

/// A salon employee (barber/hairdresser) who can be booked. Not a login account.
model Staff {
  id       String  @id @default(cuid())
  salonId  String
  name     String
  photoUrl String?
  active   Boolean @default(true)
  /// Display order within the salon's staff list.
  order    Int     @default(0)

  salon          Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  availabilities Availability[]
  appointments   Appointment[]
  /// Services this person can perform. A service with no staff is open to everyone.
  services       Service[]
  /// Slots the salon blocked manually (congés, personal appointments…).
  timeBlocks     TimeBlock[]

  @@index([salonId])
  @@map("staff")
}

/// A section of the price list ("Coupes", "Colorations"…). Optional: a service
/// with no category simply shows up ungrouped.
model ServiceCategory {
  id        String   @id @default(cuid())
  salonId   String
  name      String
  /// Display order inside the price list.
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([salonId, name])
  @@index([salonId])
  @@map("service_categories")
}

/// A bookable service (e.g. "Haircut", "Beard trim").
model Service {
  id          String  @id @default(cuid())
  salonId     String
  /// Price-list section. Null keeps the service ungrouped.
  categoryId  String?
  nameFr      String
  nameEn      String
  /// Duration in minutes used to compute the appointment end time.
  durationMin Int
  /// Price in cents (avoids floating-point rounding).
  priceCents  Int     @default(0)
  /// Buffer minutes added after the service before the next slot.
  bufferMin   Int     @default(0)
  active      Boolean @default(true)

  salon        Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Staff who can perform it. Empty means every active staff member can.
  staff        Staff[]
  appointments Appointment[]

  @@index([salonId])
  @@index([categoryId])
  @@map("services")
}

/// A slot blocked manually on the calendar (holiday, personal appointment…).
/// Excluded from the public availability, but visible in the dashboard agenda.
model TimeBlock {
  id        String   @id @default(cuid())
  salonId   String
  staffId   String
  startAt   DateTime
  endAt     DateTime
  /// Optional reason shown on the agenda.
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([salonId, staffId, startAt])
  @@map("time_blocks")
}

/// Recurring weekly availability for a staff member.
model Availability {
  id         String  @id @default(cuid())
  salonId    String
  staffId    String
  /// 0 = Sunday … 6 = Saturday.
  weekday    Int     @db.SmallInt
  /// "HH:mm" 24-hour format.
  startTime  String
  /// "HH:mm" 24-hour format.
  endTime    String
  /// Optional break window start, "HH:mm".
  breakStart String?
  /// Optional break window end, "HH:mm".
  breakEnd   String?

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([salonId, staffId, weekday])
  @@map("availabilities")
}

/// An end customer, scoped to a salon.
model Client {
  id          String   @id @default(cuid())
  salonId     String
  phone       String?
  email       String?
  name        String
  locale      String   @default("fr")
  consentRgpd Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  reviews      Review[]

  @@index([phone])
  @@index([salonId, email])
  @@map("clients")
}

/// A booked appointment for a staff member and service.
model Appointment {
  id        String            @id @default(cuid())
  salonId   String
  staffId   String
  serviceId String
  clientId  String
  startAt   DateTime
  endAt     DateTime
  status    AppointmentStatus @default(PENDING)
  source    AppointmentSource @default(WEB)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  salon         Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staff         Staff          @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([salonId, startAt])
  @@index([staffId, startAt])
  @@index([clientId])
  @@map("appointments")
}

/// A notification sent (or to be sent) for an appointment.
model Notification {
  id            String              @id @default(cuid())
  appointmentId String
  channel       NotificationChannel
  status        NotificationStatus  @default(PENDING)
  sentAt        DateTime?
  error         String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("notifications")
}

/// The canonical Stripe subscription record for a salon (one per salon).
model Subscription {
  id               String             @id @default(cuid())
  salonId          String             @unique
  plan             Plan
  status           SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime?
  stripeSubId      String?            @unique

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// A customer review for a salon.
model Review {
  id        String   @id @default(cuid())
  salonId   String
  clientId  String
  /// 1–5 stars.
  rating    Int      @db.SmallInt
  comment   String?
  createdAt DateTime @default(now())

  salon  Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([salonId])
  @@index([clientId])
  @@map("reviews")
}

/// A localized CMS page for a salon.
model Page {
  id          String  @id @default(cuid())
  salonId     String
  locale      String  @default("fr")
  title       String
  description String?
  contentJson Json    @default("{}") @db.JsonB

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, locale])
  @@map("pages")
}

/// Static UI translation keyed by a stable `key` (fr is the source locale).
model Translation {
  id  String  @id @default(cuid())
  key String  @unique
  fr  String
  /// Optional until the key is translated to English.
  en  String?

  @@map("translations")
}

/// Async background job (notification delivery), processed by the worker cron.
model Job {
  id        String    @id @default(cuid())
  /// Job type, e.g. "notification.confirmation".
  type      String
  payload   Json      @default("{}")
  runAt     DateTime
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAt])
  @@map("jobs")
}
