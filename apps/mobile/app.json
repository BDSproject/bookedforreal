{
  "expo": {
    "name": "Bookedforreal",
    "slug": "bookedforreal",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "bookedforreal",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Bookedforreal to find salons near you."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookedforreal.app"
    },
    "android": {
      "package": "com.bookedforreal.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
